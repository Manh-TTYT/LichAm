<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/w_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21"
            android:textColor="@color/w_text"
            android:textSize="44sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/w_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ tư"
            android:textColor="@color/w_sub"
            android:textSize="13sp"
            android:maxLines="1" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/w_line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/w_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tháng 10 / 2026"
            android:textColor="@color/w_sub"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_lunar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="11 tháng 9 âm lịch"
            android:textColor="@color/w_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_canchi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày Đinh Mão · năm Bính Ngọ"
            android:textColor="@color/w_sub"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hắc đạo · Ngày xấu"
            android:textColor="@color/w_bad"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_holiday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone"
            android:textColor="@color/w_gold"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
